# Server runtime environment.
# Copy this file to `.env` and fill in actual values; never commit `.env` itself.

NODE_ENV=development
PORT=4000

# MongoDB connection (use local for dev; Atlas for staging/prod). Vector Search requires Atlas.
MONGODB_URI=mongodb://127.0.0.1:27017/samagama

# JWT secrets — REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string

# CORS — comma-separated list of allowed origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=info

# RAG / LLM provider — placeholders for Phase 6.
LLM_PROVIDER=mock
GEMINI_API_KEY=
EMBEDDING_PROVIDER=mock
