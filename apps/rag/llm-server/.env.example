# LLM server environment — copy to .env and fill in real values.
# This server bridges between the main backend and a local LM Studio instance.

# Port this server listens on (must NOT conflict with main backend on 4000)
PORT=5001

# Shared Bearer token — must match LLM_INTERNAL_SECRET in the root .env
INTERNAL_SECRET=yaksha-internal-secret-2026

# LM Studio base URL (default when running LM Studio locally)
LM_STUDIO_URL=http://localhost:1234
